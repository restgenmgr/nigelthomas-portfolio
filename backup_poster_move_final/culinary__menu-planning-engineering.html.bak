<meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Menu Planning & Menu Engineering: Complete Guide | Nigel Thomas</title> <meta name="description" content="Complete professional Guide to menu planning and menu engineering. Learn menu psychology, pricing strategies, food cost optimization, and recipe standardization."> <style> *{margin:0;padding:0;box-sizing:border-box;} body{font-family:'Segoe UI',Arial,sans-serif;background:#f5f0e8;line-height:1.6;} .navbar{background:#800000;padding:1rem 0;position:sticky;top:0;} .nav-container{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding:0 20px;flex-wrap:wrap;} .logo{color:#FFD700;font-size:1.5rem;font-weight:bold;text-decoration:none;} .nav-links a{color:white;text-decoration:none;padding:8px 15px;border-radius:25px;} .nav-links a:hover{background:#FFD700;color:#800000;} .container{max-width:1000px;margin:0 auto;padding:40px 20px;} .article-card{background:white;border-radius:15px;padding:40px;box-shadow:0 5px 20px rgba(0,0,0,0.1);border-left:5px solid #FFD700;} h1{color:#800000;margin-bottom:20px;font-size:1.8rem;} h2{color:#800000;margin:25px 0 15px 0;} h3{color:#800000;margin:20px 0 10px 0;} .meta{color:#666;margin-bottom:20px;padding-bottom:15px;border-bottom:1px solid #eee;} ul,ol{margin:15px 0 15px 30px;} li{margin:8px 0;} .highlight-box{background:#fef3c7;padding:20px;border-radius:10px;margin:20px 0;border-left:4px solid #FFD700;} footer{background:#800000;color:#FFD700;text-align:center;padding:30px;margin-top:40px;} .btn-back{background:#800000;color:#FFD700;padding:10px 25px;border-radius:30px;text-decoration:none;display:inline-block;margin-top:25px;} @media(max-width:768px){.nav-container{flex-direction:column;}.article-card{padding:25px;}} </style> <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4282121192943910" crossorigin="anonymous"></script> 
