<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Nigel A. Thomas | Apply Dashboard</title>
<meta content="Job search launch pad for Nigel A. Thomas — resume, cover letter, one-click job board search, and application tracker for Pan-India hospitality leadership roles." name="description"/>
<style>
  :root{
    --bg:#0a0a0a;
    --bg2:#111111;
    --gold:#d4af37;
    --gold-dim:#8a7326;
    --text:#f0ede4;
    --text-dim:#a8a49a;
    --card:#161616;
    --border:#2a2a2a;
    --success:#3f8f5f;
    --pending:#c98a2c;
    --sent:#4a7ab5;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height:1.5;
  }
  a{color:var(--gold); text-decoration:none;}
  a:hover{text-decoration:underline;}

  nav{
    position:sticky; top:0; z-index:50;
    background:#0a0a0a; border-bottom:1px solid var(--border);
    padding:14px 28px; display:flex; align-items:center; justify-content:space-between;
  }
  nav .brand{font-weight:700; letter-spacing:.5px; color:var(--gold);}
  nav .brand span{color:var(--text);}
  nav .links a{margin-left:20px; font-size:14px; color:var(--text-dim);}
  nav .links a:hover{color:var(--gold);}

  .hero{
    padding:56px 28px 40px; text-align:center;
    background:radial-gradient(ellipse at top, rgba(212,175,55,0.08), transparent 60%);
    border-bottom:1px solid var(--border);
  }
  .hero h1{font-size:2.1rem; margin:0 0 6px; letter-spacing:.3px;}
  .hero h1 .accent{color:var(--gold);}
  .hero p.tag{color:var(--text-dim); margin:0 0 22px; font-size:1.02rem;}
  .cta-row{display:flex; gap:14px; justify-content:center; flex-wrap:wrap;}
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:11px 22px; border-radius:6px; font-weight:600; font-size:14px;
    cursor:pointer; border:1px solid transparent; transition:transform .15s ease, background .15s ease;
  }
  .btn:hover{transform:translateY(-1px); text-decoration:none;}
  .btn-gold{background:var(--gold); color:#111;}
  .btn-gold:hover{background:#e6c452;}
  .btn-outline{background:transparent; border:1px solid var(--gold-dim); color:var(--gold);}
  .btn-outline:hover{border-color:var(--gold); background:rgba(212,175,55,0.08);}

  .section{max-width:1080px; margin:0 auto; padding:44px 24px;}
  .section h2{font-size:1.3rem; border-left:3px solid var(--gold); padding-left:12px; margin-bottom:6px;}
  .section p.sub{color:var(--text-dim); margin-top:0; margin-bottom:22px; font-size:14px;}

  .chips{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:8px;}
  .chip{
    padding:8px 16px; border-radius:20px; border:1px solid var(--border);
    background:var(--card); color:var(--text-dim); font-size:13.5px; cursor:pointer;
    transition:all .15s ease; user-select:none;
  }
  .chip:hover{border-color:var(--gold-dim); color:var(--text);}
  .chip.active{background:var(--gold); color:#111; border-color:var(--gold); font-weight:600;}

  .launcher{
    background:var(--card); border:1px solid var(--border); border-radius:10px; padding:22px;
  }
  .launcher-controls{display:flex; gap:12px; flex-wrap:wrap; margin-bottom:18px; align-items:center;}
  select, input[type=text]{
    background:#1c1c1c; border:1px solid var(--border); color:var(--text);
    padding:9px 12px; border-radius:6px; font-size:14px;
  }
  .board-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:14px;}
  .board-card{
    background:#1a1a1a; border:1px solid var(--border); border-radius:8px; padding:16px;
    display:flex; flex-direction:column; gap:10px;
  }
  .board-card .name{font-weight:700; font-size:15px;}
  .board-card .desc{font-size:12.5px; color:var(--text-dim); min-height:32px;}
  .board-card .go{
    align-self:flex-start; background:transparent; border:1px solid var(--gold-dim); color:var(--gold);
    padding:7px 14px; border-radius:5px; font-size:13px; cursor:pointer; font-weight:600;
  }
  .board-card .go:hover{background:var(--gold); color:#111;}

  table{width:100%; border-collapse:collapse; font-size:13.5px;}
  th, td{padding:10px 8px; border-bottom:1px solid var(--border); text-align:left;}
  th{color:var(--gold); font-size:12px; text-transform:uppercase; letter-spacing:.4px;}
  td input, td select{width:100%; background:transparent; border:none; color:var(--text); font-size:13.5px; padding:4px;}
  td input:focus, td select:focus{outline:1px solid var(--gold-dim); background:#1c1c1c;}
  .status-pill{padding:3px 10px; border-radius:12px; font-size:12px; font-weight:600; display:inline-block;}
  .status-Applied{background:rgba(74,122,181,.18); color:#7aa8de;}
  .status-Follow-up{background:rgba(201,138,44,.18); color:var(--pending);}
  .status-Interview{background:rgba(63,143,95,.18); color:#6fce8f;}
  .status-Rejected{background:rgba(180,60,60,.18); color:#e08585;}
  .status-Offer{background:rgba(212,175,55,.2); color:var(--gold);}

  .table-actions{display:flex; gap:10px; margin-top:14px; flex-wrap:wrap;}
  .del-btn{background:none; border:1px solid #4a2a2a; color:#d98a8a; padding:4px 10px; border-radius:5px; font-size:12px; cursor:pointer;}
  .del-btn:hover{background:#3a1a1a;}
  .empty-row td{color:var(--text-dim); text-align:center; padding:24px;}

  footer{border-top:1px solid var(--border); padding:26px 24px; text-align:center; color:var(--text-dim); font-size:13px;}
  footer a{color:var(--text-dim);}
  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--gold); color:#111; padding:10px 20px; border-radius:6px; font-weight:600;
    font-size:13.5px; opacity:0; pointer-events:none; transition:all .25s ease; z-index:100;
  }
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  @media (max-width:600px){
    .hero h1{font-size:1.6rem;}
    nav .links{display:none;}
  }
</style>
</head>
<body>
<nav>
<div class="brand">NIGEL A. <span>THOMAS</span></div>
<div class="links">
<a href="https://nigelthomas.live" target="_blank">Portfolio</a>
<a href="https://www.linkedin.com/in/nathomas-hospitality" target="_blank">LinkedIn</a>
<a href="https://nigelthomas.live/nigel_job_dashboard.html" target="_blank">Job Board Dashboard</a>
</div>
</nav>
<section class="hero">
<h1>Apply <span class="accent">Dashboard</span></h1>
<p class="tag">Resume, cover letter, and one-click access to the boards where Pan-India hospitality leadership roles get posted.</p>
<div class="cta-row">
<a class="btn btn-gold" download="" href="Nigel_Thomas_Resume.pdf">Download Resume</a>
<a class="btn btn-gold" download="" href="Nigel_Thomas_Cover_Letter.pdf">Download Cover Letter</a>
<button class="btn btn-outline" onclick="copyEmail()">Copy Email</button>
</div>
</section>
<section class="section" id="launcher-section">
<h2>Search the Boards</h2>
<p class="sub">Location defaults to India-wide. Change it for a specific city, then hit search on any board — each opens a pre-filled results page in a new tab.</p>
<div class="launcher">
<div class="launcher-controls">
<label style="font-size:13px;color:var(--text-dim);">Location </label>
<input id="locationInput" style="min-width:160px;" type="text" value="India"/>
<span style="font-size:12.5px;color:var(--text-dim);">Currently searching: <strong id="currentRoleLabel" style="color:var(--gold);">General Manager</strong></span>
</div>
<div class="board-grid" id="boardGrid"></div>
</div>
</section>
<section class="section" id="tracker">
<h2>Application Tracker</h2>
<p class="sub">Log every application as you send it. Saved automatically in this browser.</p>
<table id="trackerTable">
<thead>
<tr>
<th style="width:16%;">Company</th>
<th style="width:16%;">Role</th>
<th style="width:12%;">Platform</th>
<th style="width:12%;">Date Applied</th>
<th style="width:13%;">Status</th>
<th style="width:21%;">Notes</th>
<th style="width:6%;"></th>
</tr>
</thead>
<tbody id="trackerBody"></tbody>
</table>
<div class="table-actions">
<button class="btn btn-outline" onclick="addRow()">+ Add Application</button>
<button class="btn btn-outline" onclick="exportCSV()">Export CSV</button>
</div>
</section>
<footer>
  Nigel A. Thomas · Mumbai, India · +91 97693 51231 · restgenmgr1952@gmail.com<br/>
<a href="https://nigelthomas.live" target="_blank">nigelthomas.live</a> · <a href="https://www.linkedin.com/in/nathomas-hospitality" target="_blank">LinkedIn</a>
</footer>
<div class="toast" id="toast"></div>
<script>
const ROLES = [
  "General Manager",
  "Resort Manager",
  "Director of Operations",
  "Director of F&B",
  "Head of F&B",
  "Corporate Training & Quality Manager",
  "Restaurant Manager",
  "Head of Operations",
  "Hotel Operations Manager"
];

let currentRole = ROLES[0];

const BOARDS = [
  {
    name: "LinkedIn",
    desc: "Largest network for leadership-level hospitality roles.",
    build: (role, loc) => `https://www.linkedin.com/jobs/search/?keywords=${encodeURIComponent(role)}&location=${encodeURIComponent(loc)}`
  },
  {
    name: "Naukri",
    desc: "India's top job board — strong for GM/Ops roles.",
    build: (role, loc) => `https://www.naukri.com/${slugify(role)}-jobs-in-${slugify(loc)}`
  },
  {
    name: "Indeed India",
    desc: "Broad aggregator, good for smaller hospitality brands.",
    build: (role, loc) => `https://in.indeed.com/jobs?q=${encodeURIComponent(role)}&l=${encodeURIComponent(loc)}`
  },
  {
    name: "Glassdoor",
    desc: "Search plus company reviews and salary insight.",
    build: (role) => `https://www.glassdoor.co.in/Job/jobs.htm?sc.keyword=${encodeURIComponent(role)}&locT=N&locId=115`
  },
  {
    name: "Foundit",
    desc: "Formerly Monster India — active recruiter postings.",
    build: (role, loc) => `https://www.foundit.in/search/${slugify(role)}-jobs-in-${slugify(loc)}`
  },
  {
    name: "Shine",
    desc: "India-focused board, good for mid-large hotel chains.",
    build: (role, loc) => `https://www.shine.com/job-search/${slugify(role)}-jobs-in-${slugify(loc)}`
  },
  {
    name: "Hcareers",
    desc: "Hospitality-specific board, useful for international leads.",
    build: (role) => `https://www.hcareers.com/jobs?keywords=${encodeURIComponent(role)}`
  },
  {
    name: "Times Job / TimesAscent",
    desc: "Strong for senior/management-level India listings.",
    build: (role, loc) => `https://www.timesjobs.com/candidate/job-search.html?searchType=personalizedSearch&from=submit&txtKeywords=${encodeURIComponent(role)}&txtLocation=${encodeURIComponent(loc)}`
  }
];

function slugify(s){
  return s.toLowerCase().trim().replace(/&/g,'and').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');
}

function renderRoleChips(){
  const wrap = document.getElementById('roleChips');
  wrap.innerHTML = '';
  ROLES.forEach(role => {
    const chip = document.createElement('div');
    chip.className = 'chip' + (role === currentRole ? ' active' : '');
    chip.textContent = role;
    chip.onclick = () => { currentRole = role; renderRoleChips(); renderBoards(); document.getElementById('currentRoleLabel').textContent = role; };
    wrap.appendChild(chip);
  });
}

function renderBoards(){
  const grid = document.getElementById('boardGrid');
  grid.innerHTML = '';
  const loc = document.getElementById('locationInput').value || 'India';
  BOARDS.forEach(board => {
    const card = document.createElement('div');
    card.className = 'board-card';
    card.innerHTML = `<div class="name">${board.name}</div><div class="desc">${board.desc}</div><button class="go">Search →</button>`;
    card.querySelector('.go').onclick = () => window.open(board.build(currentRole, loc), '_blank');
    grid.appendChild(card);
  });
}

document.getElementById('locationInput').addEventListener('input', renderBoards);

function copyEmail(){
  navigator.clipboard.writeText('restgenmgr1952@gmail.com').then(()=>showToast('Email copied to clipboard'));
}

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2200);
}

// --- Application Tracker (persisted via localStorage) ---
const STORAGE_KEY = 'nigel_applications';
let applications = [];

function loadApplications(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    applications = raw ? JSON.parse(raw) : [];
  }catch(e){
    applications = [];
  }
}

function saveApplications(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(applications));
  }catch(e){
    console.error('Could not save applications', e);
  }
}

function renderTracker(){
  const body = document.getElementById('trackerBody');
  body.innerHTML = '';
  if(applications.length === 0){
    body.innerHTML = '<tr class="empty-row"><td colspan="7">No applications logged yet. Click "+ Add Application" to start tracking.</td></tr>';
    return;
  }
  applications.forEach((app, idx) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input type="text" value="${escapeAttr(app.company)}" data-field="company" data-idx="${idx}"></td>
      <td><input type="text" value="${escapeAttr(app.role)}" data-field="role" data-idx="${idx}"></td>
      <td><input type="text" value="${escapeAttr(app.platform)}" data-field="platform" data-idx="${idx}"></td>
      <td><input type="text" value="${escapeAttr(app.date)}" placeholder="YYYY-MM-DD" data-field="date" data-idx="${idx}"></td>
      <td>
        <select data-field="status" data-idx="${idx}">
          ${['Applied','Follow-up','Interview','Offer','Rejected'].map(s => `<option value="${s}" ${s===app.status?'selected':''}>${s}</option>`).join('')}
        </select>
      </td>
      <td><input type="text" value="${escapeAttr(app.notes)}" data-field="notes" data-idx="${idx}"></td>
      <td><button class="del-btn" data-idx="${idx}">Remove</button></td>
    `;
    body.appendChild(tr);
  });

  body.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('change', (e) => {
      const idx = e.target.dataset.idx;
      const field = e.target.dataset.field;
      applications[idx][field] = e.target.value;
      saveApplications();
    });
  });
  body.querySelectorAll('.del-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const idx = e.target.dataset.idx;
      applications.splice(idx, 1);
      saveApplications();
      renderTracker();
    });
  });
}

function escapeAttr(s){
  return (s || '').toString().replace(/&/g,'&amp;').replace(/"/g,'&quot;');
}

function addRow(){
  applications.push({company:'', role: currentRole, platform:'', date: new Date().toISOString().slice(0,10), status:'Applied', notes:''});
  saveApplications();
  renderTracker();
}

function exportCSV(){
  if(applications.length === 0){ showToast('No applications to export yet'); return; }
  const header = ['Company','Role','Platform','Date Applied','Status','Notes'];
  const rows = applications.map(a => [a.company, a.role, a.platform, a.date, a.status, a.notes]);
  const csv = [header, ...rows].map(r => r.map(v => `"${(v||'').toString().replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob = new Blob([csv], {type:'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'nigel_thomas_applications.csv';
  a.click();
  URL.revokeObjectURL(url);
}

// init
renderRoleChips();
renderBoards();
loadApplications();
renderTracker();
</script>
<div class="infomatics-launcher">
<button aria-expanded="false" class="infomatics-btn" onclick="var p=document.getElementById('infomatics-panel');var open=p.classList.toggle('active');this.setAttribute('aria-expanded', open?'true':'false');" type="button">
    Infomatics
  </button>
<div class="infomatics-panel" id="infomatics-panel">

</div>
</div>
<style>
.infomatics-launcher{margin:2rem 0;}
.infomatics-btn{padding:0.6em 1.4em;border:none;border-radius:6px;background:#1f2937;color:#fff;font-weight:600;cursor:pointer;}
.infomatics-btn:hover{background:#374151;}
.infomatics-panel{display:none;margin-top:1rem;}
.infomatics-panel.active{display:block;}
</style>

<div class="infomatics-launcher">
<button aria-expanded="false" class="infomatics-btn" onclick="var p=document.getElementById('infomatics-panel');var open=p.classList.toggle('active');this.setAttribute('aria-expanded', open?'true':'false');" type="button">
    Infomatics
  </button>
<div class="infomatics-panel" id="infomatics-panel">
<section class="section" id="roles">
<h2>Target Roles</h2>
<p class="sub">Pick a role — it filters every search link below.</p>
<div class="chips" id="roleChips"></div>
</section>
</div>
</div>
<style>
.infomatics-launcher{margin:2rem 0;}
.infomatics-btn{padding:0.6em 1.4em;border:none;border-radius:6px;background:#1f2937;color:#fff;font-weight:600;cursor:pointer;}
.infomatics-btn:hover{background:#374151;}
.infomatics-panel{display:none;margin-top:1rem;}
.infomatics-panel.active{display:block;}
</style>
</body>
</html>
