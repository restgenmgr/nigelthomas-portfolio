"false\",\"ruleID\":\"default\"},{\"gate\":\"3014785993\",\"gateValue\":\"false\",\"ruleID\":\"6Ajlvt0GOeffJIPmMu9aRh\"},{\"gate\":\"3737660407\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3720285278\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3623026190\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":557,\"id_type\":\"workspace_id\",\"value\":{\"enable_api\":false,\"enabled_example_skills_for_chatgpt\":[],\"container_tool_skill_code_execution_instructions\":\" \",\"enable_in_arcade\":false,\"enable_skills_container_upload\":false,\"enable_separate_pineapple\":false,\"enable_pineapple\":false,\"enable_public_endpoints\":true,\"enabled_system_skills\":[]},\"is_device_based\":false,\"passed\":false},\"3075710337\":{\"name\":\"3075710337\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":28,\"id_type\":\"userID\",\"value\":{\"connector_68df038e0ba48191908c8434991bbac2\":4,\"connector_68d579f7b0948191a7da3124a3b560f7\":2,\"connector_68df33b1a2d081918778431a9cfca8ba\":5,\"connector_68e004f14af881919eb50893d3d9f523\":7,\"connector_68de829bf7648191acd70a907364c67c\":1,\"connector_68f1abff1b688191b9309a31c9b4a713\":6,\"connector_69272cb413a081919685ec3c88d1744e\":6,\"connector_68e01e8c1c2081918b4567a0b959d3ff\":3,\"connector_68f1afc5a6008191a701eaaab428816c\":6},\"is_device_based\":false,\"passed\":false},\"734083401\":{\"name\":\"734083401\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"name\":\"email\",\"enabled\":true,\"tempDisabled\":false,\"loginStrategy\":\"existing_user\",\"kind\":\"username\"},\"is_device_based\":false,\"passed\":false},\"1811233013\":{\"name\":\"1811233013\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"ads_segment_id\",\"value\":{\"show_ask_chatgpt_menu_item\":true,\"late_ads_visibility_gate_enabled\":false,\"android_display_zoom_scale_threshold\":0,\"consent_modal_title\":\"Make ads relevant fo