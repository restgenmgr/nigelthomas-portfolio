\"is_device_based\":false,\"passed\":false},\"2414703414\":{\"name\":\"2414703414\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":2,\"id_type\":\"userID\",\"value\":{\"credit_purchase_quantity_max\":250000},\"is_device_based\":false,\"passed\":false},\"4005134340\":{\"name\":\"4005134340\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1007700932\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":17,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"2391622925\":{\"name\":\"2391622925\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"configuration_url\":\"https://chatgpt.com/admin\",\"self_serve_business_access_token_creation_enabled\":true,\"use_backend_generated_jwt\":true},\"is_device_based\":false,\"passed\":false},\"1249441124\":{\"name\":\"1249441124\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"2674049786\":{\"name\":\"2674049786\",\"rule_id\":\"2bhHmL2CqQhKvw90VC7VjR\",\"secondary_exposures\":[],\"version\":20,\"id_type\":\"userID\",\"value\":{\"variant\":\"control\"},\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\",\"enable_web_search\":false},\"is_device_based\":false,\"passed\":false},\"762342243\":{\"name\":\"762342243\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":24,\"id_type\":\"userID\",\"value\":{\"default_rule_indicator\":true},\"is_device_based\":false,\"passed\":false},\"3660657310\":{\"name\":\"3660657310\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":26,\"id_type\":\"ads_segment_id\",\"value\":{\"show_ask_chatgpt_menu_item\":true,\"late_ads_visibility_gate_enabled\":false,\"android_display_zoom_scale_threshold\":0,\"consent_modal_title\":\"Make ads relevant for you\",\"consent_modal_short_copy\":true,\"consent_modal_variant\":\"\",\"feedback_interested_enabled\":false,\"preamble_format_preset_id\":\"\",\"consent_modal_pre_selected\":true,\"late_ads_event_discard_timeout_seconds\":5,\"keepalive_event_logger_web\":false,\"show_ask_chatgpt_button\":false,\"late_ads_slot_visibility_threshold\":0.01,\"consent_modal_enable