<script>
        // ----- 60 FOOD & BEVERAGE QUESTIONS & ANSWERS (Complete Dataset) -----
        const qaData = [
            // 1-26 (original poster questions)
            { q: "What is Food & Beverage service?", a: "Food & Beverage service involves preparing, presenting, and serving food and drinks to guests in hotels, restaurants, and catering establishments." },
            { q: "What are the types of F&B service?", a: "Table service, Buffet service, Room service, Self-service, and Takeaway service." },
            { q: "What is mise en place?", a: "“Everything in place” – preparing and organizing all items before service begins." },
            { q: "What is a menu?", a: "A list of food and beverages offered to guests along with their prices." },
            { q: "What is the role of a waiter?", a: "Takes orders, serves food and beverages, ensures guest satisfaction, and maintains service standards." },
            { q: "What is customer service in F&B?", a: "Providing polite, efficient, and friendly service to ensure a positive dining experience." },
            { q: "What is table setting?", a: "Arranging cutlery, crockery, glassware, and napkins properly on the table before service." },
            { q: "What is order taking?", a: "The process of accurately noting guests’ food and beverage requests." },
            { q: "What is upselling?", a: "Encouraging guests to purchase higher-value items or additional products." },
            { q: "What is hygiene in F&B?", a: "Maintaining cleanliness in food handling, personal grooming, and the workplace to ensure safety." },
            { q: "What is a cover?", a: "A cover refers to one guest served in a restaurant." },
            { q: "What is billing?", a: "Preparing and presenting the guest’s bill after service." },
            { q: "What is room service?", a: "Serving food and beverages to guests in their hotel rooms." },
            { q: "What is a steward?", a: "A staff member responsible for serving food and maintaining cleanliness in the restaurant." },
            { q: "Why is communication important in F&B?", a: "It helps understand guest needs, avoid mistakes, and deliver better service." },
            { q: "What is a restaurant?", a: "A place where food and beverages are prepared and served to customers." },
            { q: "What is fine dining?", a: "A formal dining experience with high-quality food, elegant ambiance, and professional service." },
            { q: "What is casual dining?", a: "A relaxed dining style with moderate pricing and informal service." },
            { q: "What is a buffet?", a: "A self-service style where guests serve themselves from a variety of dishes." },
            { q: "What is à la carte?", a: "A menu where each item is priced and ordered separately." },
            { q: "What is table d’hôte?", a: "A fixed menu with a set price and limited choices." },
            { q: "What is a cover charge?", a: "A fixed fee charged per guest, sometimes including basic items or entertainment." },
            { q: "What is a cocktail?", a: "An alcoholic mixed drink made with spirits, mixers, and flavorings." },
            { q: "What is a mocktail?", a: "A non-alcoholic mixed drink." },
            { q: "What is a sideboard?", a: "A service station used to store extra cutlery, napkins, and service items." },
            { q: "What is a KOT?", a: "KOT (Kitchen Order Ticket) is used to communicate food orders to the kitchen." },
            // 27-60 (new questions)
            { q: "What is the difference between a starter and an appetizer?", a: "Often used interchangeably, but appetizers are typically lighter and served before the main course, while starters can be more substantial." },
            { q: "What is the pantry section in a kitchen?", a: "The station responsible for cold dishes – salads, cold appetizers, sandwiches, and cold sauces." },
            { q: "What is the purpose of a garnish?", a: "To add visual appeal, complementary texture, and contrasting flavor to the finished dish." },
            { q: "What does 'batch cooking' mean?", a: "Preparing large quantities of a specific dish in advance to streamline service during peak hours." },
            { q: "What is a POS system?", a: "Point of Sale – the software/hardware used to take orders, process payments, and track sales data." },
            { q: "What is a food runner?", a: "The team member who delivers finished plates from the kitchen pass to the correct guest tables." },
            { q: "Why is temperature control critical in F&B?", a: "To prevent bacterial growth. Food must be kept below 40°F (4°C) or above 140°F (60°C)." },
            { q: "What is a continental breakfast?", a: "A light morning meal typically consisting of pastries, bread, fruit, coffee, and juice." },
            { q: "What is an American breakfast?", a: "A heavier breakfast with eggs, bacon or sausage, fried potatoes, toast, and a hot beverage." },
            { q: "What is a food allergen?", a: "A protein that triggers an immune response; common ones include dairy, nuts, gluten, shellfish, and eggs." },
            { q: "What is a sommelier?", a: "A trained wine expert who manages wine selection, storage, service, and pairing with food." },
            { q: "What is a barista?", a: "A specialist in preparing espresso-based coffee drinks, often skilled in latte art." },
            { q: "What is the temperature danger zone?", a: "The range between 40°F and 140°F (4°C–60°C) where bacteria multiply most rapidly." },
            { q: "What is cross-contamination?", a: "The transfer of bacteria or allergens from one food item, surface, or utensil to another." },
            { q: "What is FIFO in storage?", a: "First In, First Out – an inventory rotation method ensuring older stock is used before newer deliveries." },
            { q: "What is a banquet?", a: "A large formal gathering with a pre-planned, multi-course menu served to a large number of guests." },
            { q: "What is a tasting menu?", a: "A curated, multi-course meal designed to showcase the chef's best dishes, often with wine pairings." },
            { q: "What is gueridon service?", a: "Tableside preparation or carving using a mobile trolley – often used for flambé dishes or carving meats." },
            { q: "What is a chafing dish?", a: "A heated serving vessel that uses fuel to keep buffet food warm during service." },
            { q: "What is a waiter's mise en place?", a: "Preparing your station with enough cutlery, glassware, napkins, condiments, and menus before service." },
            { q: "What is a decanter?", a: "A glass vessel used to aerate wine and separate it from sediment before serving." },
            { q: "What is the role of a head waiter?", a: "Supervises waitstaff, assigns stations, oversees service flow, and ensures guest satisfaction." },
            { q: "What is a busser?", a: "Assists waitstaff by clearing and resetting tables, and maintaining general cleanliness in the dining area." },
            { q: "What is a cheeseboard?", a: "A selection of cheeses served with bread, crackers, fruits, and chutneys as an appetizer or dessert." },
            { q: "What is a digestif?", a: "An alcoholic beverage served after a meal to aid digestion – e.g., brandy, grappa, or amaro." },
            { q: "What is an aperitif?", a: "A light alcoholic drink served before a meal to stimulate the appetite – e.g., vermouth, prosecco." },
            { q: "What is a demi-glace?", a: "A rich, dark sauce made by slowly reducing veal stock and brown sauce, used as a base for many dishes." },
            { q: "What is flambé?", a: "A technique where alcohol (e.g., brandy or rum) is added to a hot pan and ignited to add flavor and theatrical flair." },
            { q: "What is sous-vide?", a: "A precise cooking method where food is vacuum-sealed and cooked in a temperature-controlled water bath." },
            { q: "What does '86' mean in a kitchen?", a: "Slang indicating that a menu item is unavailable or out of stock." },
            { q: "What is a dupe ticket?", a: "A duplicate order ticket sent to the bar or kitchen to inform them of what needs to be prepared." },
            { q: "What is a walk-in cooler?", a: "A large, refrigerated storage room used to keep bulk perishable ingredients at safe temperatures." },
            { q: "What is a speed rack?", a: "A mobile shelving unit used to store sheet pans, commonly seen in high-volume bakeries and prep kitchens." },
            { q: "What is a POS transaction?", a: "The final step of a sale – using the Point of Sale system to process cash, card, or digital payments." }
        ];

        // ---- Render Poster Grid ----
        const posterGrid = document.getElementById('posterGrid');
        let posterHTML = '';
        qaData.forEach((item, idx) => {
            const num = (idx + 1).toString().padStart(2, '0');
            // Bold the question inside the answer span
            const answerHTML = item.a.replace(/([^.]*\.)/, '<strong>$1</strong>'); // crude but effective bold for first sentence
            posterHTML += `
                <div class="poster-item">
                    <span class="q">${num}.</span>
                    <span class="a"><strong>${item.q}</strong> ${item.a}</span>
                </div>
            `;
        });
        posterGrid.innerHTML = posterHTML;

        // ---- Render Expanded Q&A ----
        const expandedContainer = document.getElementById('expandedQA');
        let expandedHTML = '';
        qaData.forEach((item, idx) => {
            const num = (idx + 1).toString().padStart(2, '0');
            // Expert insight – generate a unique commentary for each to enrich the article.
            let insight = '';
            if (idx < 26) {
                insight = 'This foundational question tests your core understanding of F&B operations. Interviewers expect a concise, accurate definition that shows you know the basics.';
            } else if (idx >= 26 && idx < 40) {
                insight = 'This question digs into practical, everyday knowledge. A strong answer uses specific examples (e.g., names of dishes, equipment, or safety protocols).';
            } else {
                insight = 'This advanced topic shows your depth of experience. Mentioning real-world application – like a time you used this skill – will impress any hiring manager.';
            }
            // Override specific insights for variety using a simple switch based on index
            const insights = [
                'Knowing the service cycle from prep to billing shows you understand the full guest journey.',
                'Different establishments use different styles – show you can adapt to their specific model.',
                'Mise en place is the difference between chaos and control. Share how you organise your station.',
                'A menu is a sales tool. Mention how you use it to guide guest choices.',
                'The waiter is the face of the restaurant. Emphasise hospitality and anticipation.',
                'Service is about emotion as much as efficiency. Give a story about a guest you turned around.',
                'Precision in table setting reflects the restaurant’s brand standards.',
                'Accuracy prevents waste and unhappy guests – always repeat orders back.',
                'Upselling must feel natural. Frame it as “enhancing their experience”.',
                'Hygiene is non-negotiable. Mention HACCP and personal grooming habits.',
                'Covers are how we measure business volume. Show you understand busy vs. quiet service.',
                'Billing is the final impression – be accurate, clear, and gracious.',
                'Room service requires extra care with presentation and temperature.',
                'A steward is the backbone of a clean, efficient dining room.',
                'Communication prevents 90% of service errors – be clear and calm.',
                'A restaurant is a stage for hospitality. Every role contributes to the performance.',
                'Fine dining is about ritual and precision. Share an example of formal service you’ve done.',
                'Casual dining needs the same warmth, but with a faster pace.',
                'Buffets require constant monitoring of food levels and temperature.',
                'À la carte gives guests freedom; you need to know every dish inside out.',
                'Table d’hôte simplifies operations and is great for large groups.',
                'Cover charges are often misunderstood – explain them clearly to guests.',
                'Cocktails combine art and science. Know classic recipes and modern trends.',
                'Mocktails are growing in demand – treat them with the same creativity as cocktails.',
                'A tidy sideboard means fewer trips to the kitchen – speed matters.',
                'A KOT is the lifeline between front and back of house – get it right every time.',
                'This distinction shows you understand menu structure and guest expectations.',
                'Knowing kitchen stations shows you respect the brigade system.',
                'Garnishes are the final brushstroke – they elevate the dish visually.',
                'Batch cooking is a cost-saving strategy that requires careful planning.',
                'POS systems are the nerve centre of modern restaurants – be tech-savvy.',
                'The runner bridges the kitchen and dining room – speed with accuracy.',
                'Temperature control is a legal requirement – know the danger zone by heart.',
                'Continental breakfasts are a hotel staple – efficient and popular.',
                'American breakfasts are hearty and profitable – upsell the add-ons.',
                'Allergen awareness is a matter of safety and trust – take it seriously.',
                'A sommelier builds trust with guests – recommending wine is a relationship.',
                'Coffee culture is huge – baristas are in high demand.',
                'The danger zone is food safety 101 – cite it in every interview.',
                'Cross-contamination is a hidden threat – always use separate boards.',
                'FIFO prevents waste and ensures quality – a logistical must.',
                'Banquets are high-stakes events – planning is everything.',
                'Tasting menus show off culinary creativity and precision.',
                'Gueridon service adds theatre and luxury to the guest experience.',
                'Chafing dishes are simple but require careful fuel management.',
                'A waiter’s mise en place is their secret weapon for a smooth shift.',
                'Decanting wine shows sophistication – learn the proper technique.',
                'The head waiter leads by example and handles the flow of service.',
                'Bussers are unsung heroes – their speed keeps the floor moving.',
                'Cheeseboards are elegant and versatile – know your cheeses.',
                'Digestifs are a perfect closing note – suggest them to guests.',
                'Aperitifs set the mood – a refined way to start a meal.',
                'Demi-glace is the foundation of classic French cuisine.',
                'Flambé requires confidence and safety awareness – a showstopper.',
                'Sous-vide is the future of consistent cooking – learn the basics.',
                '“86” is universal kitchen slang – shows you’re a pro.',
                'Dupe tickets are vital for bar and kitchen coordination.',
                'Walk-in coolers are the heart of back-of-house storage.',
                'Speed racks improve workflow in high-volume settings.',
                'A POS transaction is the final touchpoint – handle it with care.'
            ];
            // Assign the corresponding insight, or a generic one if we missed
            const finalInsight = insights[idx] || 'This question tests your practical knowledge. Use a specific example from your experience to illustrate.';

            expandedHTML += `
                <div class="qa-expand">
                    <div><span class="qnum">${num}</span><span class="question">${item.q}</span></div>
                    <div class="answer"><strong>Core Answer:</strong> ${item.a}</div>
                    <div class="answer" style="margin-top:10px;"><strong>Expert Insight:</strong> ${finalInsight}</div>
                </div>
            `;
        });
        expandedContainer.innerHTML = expandedHTML;

        console.log(`✅ Loaded ${qaData.length} Food & Beverage Q&As (Black & Gold Theme)`);
    </script>
<div class="infomatics-launcher">
<button aria-expanded="false" class="infomatics-btn" onclick="var p=document.getElementById('infomatics-panel');var open=p.classList.toggle('active');this.setAttribute('aria-expanded', open?'true':'false');" type="button">
    Infomatics
  </button>
<div class="infomatics-panel" id="infomatics-panel">



</div>
</div>
