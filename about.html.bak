        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:'Segoe UI',Arial,sans-serif;
            background:#0a0a0a;
            color:#dddddd;
            line-height:1.7;
        }

        a{
            text-decoration:none;
        }

        .navbar{
            background:#000;
            border-bottom:2px solid #d4af37;
            position:sticky;
            top:0;
            z-index:999;
        }

        .nav-container{
            max-width:1200px;
            margin:auto;
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:18px 25px;
            flex-wrap:wrap;
        }

        .logo{
            color:#d4af37;
            font-size:28px;
            font-weight:bold;
        }

        .nav-links{
            display:flex;
            gap:18px;
            flex-wrap:wrap;
        }

        .nav-links a{
            color:#ffffff;
            transition:.3s;
        }

        .nav-links a:hover,
        .nav-links .active{
            color:#d4af37;
        }

        .hero{
            padding:80px 20px;
            text-align:center;
            background:linear-gradient(135deg,#000,#1b1b1b);
            border-bottom:2px solid #d4af37;
        }

        .hero h1{
            font-size:52px;
            color:#d4af37;
            margin-bottom:15px;
        }

        .hero p{
            font-size:22px;
            color:#cccccc;
        }

        .container{
            max-width:1200px;
            margin:auto;
            padding:60px 25px;
        }

        .om-grid{
            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:20px;
            margin-bottom:30px;
        }

        .om-card{
            background:#0d0d0d;
            border:1px solid #2a2823;
            border-left:4px solid #d4af37;
            border-radius:12px;
            padding:22px 24px;
        }

        .om-card-head{
            display:flex;
            align-items:center;
            gap:14px;
            margin-bottom:12px;
        }

        .om-num{
            width:30px;height:30px;
            border-radius:50%;
            background:#d4af37;
            color:#000;
            display:flex;align-items:center;justify-content:center;
            font-weight:bold;font-size:14px;
            flex-shrink:0;
        }

        .om-icon{
            color:#d4af37;
            font-size:18px;
            width:22px;text-align:center;
        }

        .om-card h3{
            color:#ffffff;
            font-size:18px;
        }

        .om-card ul{
            padding-left:20px;
            font-size:14.5px;
            color:#bbbbbb;
        }

        .om-values{
            display:flex;
            flex-wrap:wrap;
            justify-content:center;
            gap:14px;
            margin:35px 0;
            padding:22px;
            background:#0d0d0d;
            border:1px solid #2a2823;
            border-radius:12px;
        }

        .om-values div{
            text-align:center;
            min-width:110px;
        }

        .om-values i{
            color:#d4af37;
            font-size:22px;
            display:block;
            margin-bottom:8px;
        }

        .om-values span{
            font-size:12.5px;
            letter-spacing:1px;
            text-transform:uppercase;
            color:#d4af37;
            font-weight:600;
        }

        .om-quote{
            text-align:center;
            padding:25px;
            border-top:1px solid #d4af37;
            border-bottom:1px solid #d4af37;
            margin-bottom:30px;
        }

        .om-quote p{
            font-style:italic;
            font-size:17px;
            color:#eeeeee;
        }

        .om-strip{
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:16px;
            text-align:center;
        }

        .om-strip div{
            padding:16px 10px;
        }

        .om-strip i{
            color:#d4af37;
            font-size:20px;
            display:block;
            margin-bottom:8px;
        }

        .om-strip h4{
            color:#ffffff;
            font-size:13.5px;
            margin-bottom:4px;
        }

        .om-strip p{
            font-size:12px;
            color:#999999;
            line-height:1.4;
        }

        .om-tagline{
            text-align:center;
            margin-top:25px;
            color:#d4af37;
            letter-spacing:1px;
            font-size:14px;
            text-transform:uppercase;
        }

        .tag{
            background:#0d0d0d;
            border:1px solid #2a2823;
            border-left:3px solid #d4af37;
            color:#e6c65c;
            padding:8px 16px;
            border-radius:20px;
            font-size:13px;
            font-weight:600;
            letter-spacing:0.3px;
        }
        @media(max-width:768px){

            .hero h1{
                font-size:34px;
            }

            .hero p{
                font-size:18px;
            }

            .nav-container{
                flex-direction:column;
                gap:15px;
            }

            .om-grid{
                grid-template-columns:1fr;
            }

            .om-strip{
                grid-template-columns:1fr 1fr;
            }

        }

    </style>

