<script id="nt-infomatics-js">
document.addEventListener("click", function (event) {
    var button = event.target.closest(".nt-infomatics-button");
    if (!button) return;
    var panelId = button.getAttribute("data-panel");
    var panel = document.getElementById(panelId);
    if (!panel) return;
    var opened = panel.classList.toggle("show");
    button.textContent = opened ? "HIDE INFOMATICS" : "VIEW INFOMATICS";
    button.setAttribute("aria-expanded", opened ? "true" : "false");
    panel.setAttribute("aria-hidden", opened ? "false" : "true");
});
</script>


</div>

<!-- NT INFOMATICS -->
<div class="nt-infomatics-section" style="margin: 40px 0;">
    <button type="button" class="nt-infomatics-button" data-panel="nt-infomatics-panel" aria-expanded="false">
        VIEW INFOMATICS
    </button>
    <div id="nt-infomatics-panel" class="nt-infomatics-panel" aria-hidden="true" style="margin-top:20px;">
        <div class="poster-wrap">
            <img src="/assets/career-summary.png" alt="Infographic" style="max-width:100%; height:auto; border-radius:8px; display:block; margin:0 auto;"/>
        </div>
        <p style="font-size:0.9em;color:#666;margin-top:10px;text-align:center;">
            💡 Right-click the image to save it.
        </p>
    </div>
</div>
<!-- END NT INFOMATICS -->

