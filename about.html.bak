<section class="hero">
<h1>About Nigel Thomas</h1>
<p>
Hospitality Executive • Operations Leader • Hospitality Trainer
</p>
</section>
<div class="container">
<!-- Profile Section -->
<section style="display:flex;flex-wrap:wrap;gap:40px;align-items:center;margin-bottom:60px;">
<div style="flex:1;min-width:280px;text-align:center;">

</div>
<div style="flex:2;min-width:320px;">
<h2 style="color:#d4af37;font-size:36px;margin-bottom:20px;">
                Nigel Anthony Thomas
            </h2>
<h3 style="color:#ffffff;font-weight:400;margin-bottom:25px;">
                Hospitality Executive | Operations Leader | Hospitality Trainer
            </h3>
<p style="margin-bottom:18px;">
                I am a hospitality professional with more than <strong>30 years of international leadership experience</strong>
                across luxury hotels, resorts, restaurants, cafés and international cruise lines.
            </p>
<p style="margin-bottom:18px;">
                Throughout my career I have successfully led business turnarounds, managed multi-million-dollar food &amp;
                beverage operations, improved profitability, implemented operational standards and developed high-performing teams.
            </p>
<p style="margin-bottom:18px;">
                My experience spans India, the Middle East and the United States, giving me extensive exposure to multicultural
                operations, international service standards and executive leadership.
            </p>
<div style="margin-top:30px;display:flex;gap:20px;flex-wrap:wrap;">
<a href="resume.html" style="background:#d4af37;color:#000;padding:14px 28px;border-radius:30px;font-weight:bold;">
                    View Resume →
                </a>
<a href="contact.html" style="border:2px solid #d4af37;color:#d4af37;padding:14px 28px;border-radius:30px;font-weight:bold;">
                    Contact Me
                </a>
</div>
</div>
</section>
<!-- Video Introduction -->
<section style="background:#111;border-left:5px solid #d4af37;padding:35px;border-radius:15px;margin-bottom:45px;text-align:center;">
<h2 style="color:#d4af37;margin-bottom:20px;">
            Watch My Introduction
        </h2>
<div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;max-width:900px;margin:0 auto;border-radius:12px;border:2px solid #d4af37;">
